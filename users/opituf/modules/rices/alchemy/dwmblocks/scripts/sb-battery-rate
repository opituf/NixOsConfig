
#!/bin/sh

total=0
found=0

for b in /sys/class/power_supply/BAT*; do
    [ -d "$b" ] || continue

    if [ -r "$b/power_now" ]; then
        watts=$(awk '{print $1/1000000}' "$b/power_now")
    elif [ -r "$b/current_now" ] && [ -r "$b/voltage_now" ]; then
        watts=$(awk -v c="$(cat "$b/current_now")" \
            -v v="$(cat "$b/voltage_now")" \
            'BEGIN {printf "%.6f", c*v/1000000000000}')
    else
        continue
    fi

    status=$(cat "$b/status" 2>/dev/null)

    case "$status" in
        Discharging)
            total=$(awk -v a="$total" -v b="$watts" \
                'BEGIN {printf "%.6f", a+b}')
            found=1
            ;;
    esac
done

if [ "$found" -eq 1 ]; then
    awk -v t="$total" 'BEGIN {printf "%.1fW\n", t}'
else
    echo "0.0W"
fi
